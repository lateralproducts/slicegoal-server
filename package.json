        "cheerio": "^1.0.0",
        "connect-redis": "^7.1.0",
        "cors": "^2.8.1",
        "dotenv-flow": "^3.2.0",
        "eslint": "^7.32.0",
        "eslintrc": "^1.0.6",
        "eway-rapid": "^1.2.1",
        "express": "^4.14.0",
        "express-session": "^1.17.3",
        "firebase-admin": "^13.3.0",
        "graphql": "^14.4.2",
        "graphql-middleware": "^6.1.35",
