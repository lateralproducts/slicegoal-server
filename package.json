{
    "name": "slicegoal-server",
    "version": "13.0.0",
    "description": "",
    "main": "dist/index.js",
    "scripts": {
        "babel-version": "babel --version",
        "develop": "NODE_ENV=development nodemon --inspect --exec babel-node src/index.js",
        "developtest": "NODE_ENV=test nodemon --inspect --exec babel-node src/index.js",
        "start": "NODE_ENV=production node dist/index.js",
        "nm-version": "nodemon -v",
        "build": "babel -d dist/ src/ && cp -R src/emailtemplates dist/",
        "test": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --detectOpenHandles",
        "release-patch": "yarn version --patch --message",
        "release-minor": "yarn version --minor --message",
        "release-major": "yarn version --major --message",
        "lint": "eslint --ext .js --ignore-path .gitignore .",
        "lintfix": "eslint --fix --ext .js --ignore-path .gitignore .",
        "postinstall": "patch-package"
    },
    "author": "Daniel Schrader <daniel@lateralproducts.com> (https://www.slicegoal.com/app)",
    "license": "ISC",
    "devDependencies": {
