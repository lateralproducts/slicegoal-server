{
    "name": "cavestep-server",
    "version": "11.0.0",
    "description": "",
    "main": "dist/index.js",
    "scripts": {
        "babel-version": "babel --version",
        "develop": "NODE_ENV=development nodemon --inspect --exec babel-node src/index.js",
        "developtest": "NODE_ENV=test nodemon --inspect --exec babel-node src/index.js",
        "start": "NODE_ENV=development nodemon --inspect --exec babel-node src/index.js",
        "build": "babel -d dist/ src/ .env.* && cp -R src/emailtemplates dist/",
        "test": "NODE_ENV=test npx babel-node src/index.js",
        "release-patch": "yarn version --patch --message",
        "release-minor": "yarn version --minor --message",
        "release-major": "yarn version --major --message",
        "lint": "eslint --ext .js --ignore-path .gitignore .",
        "lintfix": "eslint --fix --ext .js --ignore-path .gitignore ."
    },
    "author": "Daniel Schrader <daniel@cavestep.com> (https://www.cavestep.com/app)",
    "license": "ISC",
